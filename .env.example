# ---- Graph ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=aml_password_123
NEO4J_URI=bolt://neo4j:7687

# ---- Streaming ----
KAFKA_BOOTSTRAP=redpanda:9092

# ---- Cache / case store ----
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=aml
POSTGRES_PASSWORD=aml_password_123
POSTGRES_DB=aml
POSTGRES_DSN=postgresql://aml:aml_password_123@postgres:5432/aml

# ---- LLM (provider-agnostic; used from Phase 4) ----
# Switch provider by changing these values only - no code change.
#   Ollama (default):      LLM_PROVIDER=ollama            LLM_BASE_URL=http://ollama:11434
#   OpenAI:                LLM_PROVIDER=openai            LLM_MODEL=gpt-4o-mini       LLM_API_KEY=...
#   Anthropic:             LLM_PROVIDER=anthropic         LLM_MODEL=<model id>        LLM_API_KEY=...
#   Any OpenAI-compatible: LLM_PROVIDER=openai_compatible LLM_BASE_URL=http://host:port/v1
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=
LLM_TEMPERATURE=0
OLLAMA_PULL_MODEL=llama3.1:8b

# ---- Simulator ----
SIM_TPS=20
SIM_CUSTOMERS=500
SIM_SCENARIOS_PER_MIN=6
SIM_SEED=42
SIM_MAX_TXNS=0
HIGH_RISK_COUNTRIES=IR,KP,MM

LOG_LEVEL=INFO
